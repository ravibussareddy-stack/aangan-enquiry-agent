# --- App ---------------------------------------------------------------------
APP_BASE_URL=https://aangan-agent.vercel.app
STUDIO_DOMAIN=aanganstudio.in            # placeholder attendee emails (leads+<id>@) and SMS short links
TZ_STUDIO=Asia/Kolkata

# --- Neon (written to .env.local by `neon link` / `neon env pull`) ------------
DATABASE_URL=                            # pooled — app runtime
DATABASE_URL_UNPOOLED=                   # direct — migrations (`npm run db:migrate`)
NEON_BRANCH=
NEON_AUTH_BASE_URL=                      # written by `neon env pull` (auth: true in neon.ts)
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=                 # openssl rand -base64 32
FOUNDER_EMAILS=                          # comma-separated; founder role on first sign-in
DESIGNER_EMAILS=                         # email:Designer Name, comma-separated

# --- Voice (Vaani) -----------------------------------------------------------
VOICE_PROVIDER=simulated                 # simulated (default, no credit) | vaani (real calls, capped by VOICE_SPEND_CAP)
VAANI_API_BASE=https://api.vaanivoice.ai/api
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_INBOUND_NUMBER=                    # E.164, e.g. +9120XXXXXXXX
VAANI_OUTBOUND_NUMBER=
VAANI_WEBHOOK_TOKEN=                     # secret path token for /api/voice/events (Vaani dashboard webhooks: signing unconfirmed)
VAANI_WEBHOOK_SECRET=                    # HMAC secret, if/when Vaani signs these webhooks (X-Vaani-Signature)
BRAIN_WS_URL=                            # BYOL dialogue server (wss://…), see PLAN.md §1 option A
BRAIN_AUTH_TOKEN=                        # bearer token Vaani sends to the BYOL server
BRAIN_PORT=8090
FRONT_DESK_NUMBER=                       # E.164; enables in-hours transfer for 'redirect' callers

# --- Gemini --------------------------------------------------------------------
GEMINI_API_KEYS=                         # comma-separated, fallback order
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite       # insights + post-call extraction
GEMINI_DIALOGUE_MODEL=gemini-3.5-flash-lite

# --- Cal.com -------------------------------------------------------------------
CALCOM_API_KEY=
CALCOM_API_BASE=https://api.cal.com/v2
CALCOM_EVENT_TYPE_RESIDENTIAL=
CALCOM_EVENT_TYPE_COMMERCIAL=
CALCOM_EVENT_TYPE_SITE_VISIT=
CALCOM_WEBHOOK_SECRET=                   # x-cal-signature-256
CALCOM_BOOKING_URL=                      # public booking page for the SMS link fallback

# --- HubSpot -------------------------------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_CLIENT_SECRET=                   # webhook signature (X-HubSpot-Signature-v3)
HUBSPOT_PIPELINE_ID=
HUBSPOT_PORTAL_ID=

# --- Telegram (staff only — never customers) ----------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=                 # X-Telegram-Bot-Api-Secret-Token
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_SENIOR_CHAT_ID=                 # complaints, URGENT
TELEGRAM_HELPDESK_CHAT_ID=               # "Callback needed" leads (insufficient info)
TELEGRAM_OPS_CHAT_ID=                    # error alerts

# --- SMS (customers) -----------------------------------------------------------
SMS_PROVIDER=console                     # console (zero-cost, logs only) | msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=                         # DLT header, e.g. AANGAN
MSG91_DLT_ENTITY_ID=
MSG91_WEBHOOK_SECRET=

# --- Resend --------------------------------------------------------------------
RESEND_API_KEY=
DIGEST_FROM=digest@aanganstudio.in
DIGEST_TO=

# --- Local preview only (ignored unless NODE_ENV=development) --------------------
DEV_VIEWER_ROLE=                         # "founder" to view the dashboard under `next dev` without login

# --- Cron ----------------------------------------------------------------------
CRON_SECRET=                             # Vercel cron / Neon Function trigger → Authorization: Bearer
